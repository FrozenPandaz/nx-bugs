{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "outDir": "dist",
    "sourceMap": false,
    "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo"
  },
  "include": [
    "**/*.ts",
    "**/*.js",
    "playwright.config.ts",
    "src/**/*.spec.ts",
    "src/**/*.spec.js",
    "src/**/*.test.ts",
    "src/**/*.test.js",
    "src/**/*.d.ts"
  ],
  "exclude": ["dist", "eslint.config.js"],
  "references": [
    {
      "path": "../../packages/shared/hooks/counter"
    },
    {
      "path": "../frontend/shared/business-logic"
    },
    {
      "path": "../frontend/shared/header"
    },
    {
      "path": "../../packages/shared/button"
    },
    {
      "path": "../frontend"
    }
  ]
}
